<!-- === EXAMPLE LIBRARY === -->
<a data-target="#exampleFirmwareDiv" class="collapseHead mb-2" role="button" aria-controls="exampleFirmwareDiv">
    <span class="input-group-text fw-bold">
        <i class="fa-solid fa-upload"></i>&nbsp;Example Library
    </span>
</a>
<div class="collapse show" id="exampleFirmwareDiv">
    <div class="card card-body mb-3">
        <select id="exampleSelect" class="form-select mb-3">
            <option selected disabled>-- Choose an example --</option>
        </select>
        <button type="button" id="exampleDocButton" class="btn btn-primary w-100 d-none">Browse Documentation</button>
    </div>
</div>

<!-- === CUSTOM FIRMWARE === -->
<a data-target="#customFirmwareDiv" class="collapseHead mb-2" role="button" aria-controls="customFirmwareDiv">
    <span class="input-group-text fw-bold">
        <i class="fa-solid fa-microchip"></i>&nbsp;Custom Firmware
    </span>
</a>
<div class="collapse show" id="customFirmwareDiv">
    <div class="card card-body mb-3">
        <input type="file" accept=".bin" class="form-control">
    </div>
</div>

<!-- === FLASH CONTROLS (Shared) === -->
<div class="card card-body mb-3">
    <button type="button" id="startFlashButton" class="btn btn-primary w-100 mb-3">⚡ Flash Firmware</button>
    <button type="button" id="cancelFlashButton" class="btn btn-danger w-100 d-none mb-3">✖ Cancel</button>

    <div class="d-none mb-3" id="flashProgressWrapper">
        <div class="progress">
            <div id="flashProgressBar" class="progress-bar" role="progressbar"
                 style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                0%
            </div>
        </div>
    </div>

    <div class="form-check form-switch mb-2">
        <input class="form-check-input" type="checkbox" id="toggleFlashLog">
        <label class="form-check-label mx-2 mt-1" for="toggleFlashLog">Show Flash Log</label>
    </div>

    <div class="mb-3 d-none" id="flashLogWrapper">
        <textarea id="flashLogOutput" class="form-control" rows="10" readonly></textarea>
    </div>
</div>